# direnv config -- the environment the demo assumes (`direnv allow` once).
#
# The environment itself lives in scripts/env.sh, which the demo recipes also
# source, so a shell direnv never touched gets the same one. This file keeps
# only what needs direnv: reloading when the overlay is rebuilt, and an
# interactive warning about play_launch.
watch_file demo/host_ws/install/setup.bash
watch_file scripts/env.sh
source scripts/env.sh

if command -v play_launch >/dev/null; then
    pl_ver="$(play_launch --version 2>/dev/null | awk '{print $2}')"
    case "$pl_ver" in
        0.[0-7].*|"") echo "envrc: play_launch $pl_ver is too old (need >= 0.8.2) -- run 'just setup-play-launch force'" ;;
    esac
    unset pl_ver
else
    echo "envrc: play_launch not on PATH -- run 'just setup'"
fi
