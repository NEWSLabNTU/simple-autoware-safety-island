# direnv config — the environment the demo assumes (`direnv allow` once).
#
# Prerequisites, checked (not installed) here:
#   * ROS 2 Humble          /opt/ros/humble
#   * Autoware 1.5.0        /opt/autoware/1.5.0        (planning_simulator)
#   * nano-ros checkout     $NANO_ROS_ROOT             (nros CLI + cmake pkg)
#   * play_launch on PATH   installed by `just setup`  (>= 0.8.2)
# Anything missing is reported; `just doctor` gives the same verdict on demand.

# NANO_ROS_ROOT resolution order:
#   1. the pinned third-party/nano-ros submodule -- THE DEFAULT, and it WINS
#   2. a sibling ../nano-ros checkout, only if the submodule is not initialised
#   3. an explicit env value, honoured ONLY with NANO_ROS_ALLOW_EXTERNAL_ROOT=1
#
# The submodule wins because the pin is what this repo is tested against and
# what CI builds. A sibling checkout used to win, so that local nano-ros work
# was picked up without re-pinning; the cost is that a STALE sibling silently
# replaces the pinned tree, and the symptom does not name it. On 2026-08-24 a
# sibling four commits behind supplied an `nros` CLI with no `profile`
# subcommand while the west module (symlinked to the submodule) supplied cmake
# that calls it, and the build died on `Usage: nros <COMMAND>` with nothing
# pointing at the checkout.
#
# 2026-08-26: an explicit env value used to win outright (old rule 1), on the
# theory that setting it is a deliberate act. It is not always -- a value
# INHERITED from the shell that launched a tool is indistinguishable from one
# typed on purpose, and this repo spent a session with `NANO_ROS_ROOT` and the
# cmake `nano_ros_ROOT` both silently pointing at the sibling while every `just`
# recipe printed `scripts/build/cargo.sh: /home/aeon/repos/nano-ros/...: No such
# file or directory` and carried on. So an override now has to say so:
#
#     NANO_ROS_ALLOW_EXTERNAL_ROOT=1 NANO_ROS_ROOT=/path/to/checkout ...
#
# which cannot be inherited by accident, because nothing else sets it.
_nros_submodule="$PWD/third-party/nano-ros"
_nros_sibling="$PWD/../nano-ros"

if [ -n "${NANO_ROS_ROOT:-}" ] && [ "${NANO_ROS_ALLOW_EXTERNAL_ROOT:-}" = "1" ]; then
    echo "envrc: NANO_ROS_ROOT overridden on purpose -> $NANO_ROS_ROOT" >&2
elif [ -f "$_nros_submodule/activate.sh" ]; then
    if [ -n "${NANO_ROS_ROOT:-}" ] && [ "$NANO_ROS_ROOT" != "$_nros_submodule" ]; then
        echo "envrc: ignoring inherited NANO_ROS_ROOT=$NANO_ROS_ROOT" >&2
        echo "envrc:   using the pinned submodule instead: $_nros_submodule" >&2
        echo "envrc:   (set NANO_ROS_ALLOW_EXTERNAL_ROOT=1 to override deliberately)" >&2
    fi
    NANO_ROS_ROOT="$_nros_submodule"
elif [ -f "$_nros_sibling/activate.sh" ]; then
    NANO_ROS_ROOT="$(cd "$_nros_sibling" && pwd)"
    echo "envrc: submodule not initialised -- falling back to sibling $NANO_ROS_ROOT" >&2
    echo "envrc: run 'git submodule update --init third-party/nano-ros' to use the pin" >&2
else
    NANO_ROS_ROOT="$_nros_submodule"
fi
unset _nros_submodule _nros_sibling
export NANO_ROS_ROOT

# `nano_ros_ROOT` is cmake's find_package(nano_ros) hint, and it is a SEPARATE
# footgun from the one above: cmake honours it over CMAKE_PREFIX_PATH, so a
# stale value silently resolves the cmake package to a different checkout than
# NANO_ROS_ROOT resolves the CLI to -- the two halves of one build disagreeing
# with no diagnostic. Set again after activate.sh, which also writes it.
export nano_ros_ROOT="$NANO_ROS_ROOT"

# RViz has to land somewhere — the demo box runs TurboVNC on :1 (`vncserver :1`).
export VNC_DISPLAY="${VNC_DISPLAY:-:1}"
export DISPLAY="${DISPLAY:-$VNC_DISPLAY}"

# ── ROS 2 ───────────────────────────────────────────────────────────────────
if [ -f /opt/ros/humble/setup.bash ]; then
    source /opt/ros/humble/setup.bash
else
    echo "envrc: MISSING ROS 2 Humble (/opt/ros/humble) — the demo needs it"
fi

# ── Autoware (host install; provides planning_simulator + its msgs) ──────────
if [ -f /opt/autoware/1.5.0/setup.bash ]; then
    source /opt/autoware/1.5.0/setup.bash >/dev/null 2>&1
else
    echo 'envrc: MISSING Autoware 1.5.0 (/opt/autoware/1.5.0) — "just autoware-up" will fail'
fi

# ── Demo overlay: domain_bridge + the MRM-shadowing tier4_system_launch ──────
# (built by `just demo-host-ws`; this is what disables Autoware's stock MRM)
if [ -f demo/host_ws/install/setup.bash ]; then
    watch_file demo/host_ws/install/setup.bash
    source demo/host_ws/install/setup.bash
fi

# ── play_launch (runs Autoware; installed by `just setup`) ──────────────────
# pip installs land in ~/.local/bin, which is not always on PATH.
[ -d "$HOME/.local/bin" ] && PATH_add "$HOME/.local/bin"
if command -v play_launch >/dev/null; then
    pl_ver="$(play_launch --version 2>/dev/null | awk '{print $2}')"
    case "$pl_ver" in
        0.[0-7].*|"") echo "envrc: play_launch $pl_ver is too old (need >= 0.8.2) — run 'just setup-play-launch force'" ;;
    esac
    unset pl_ver
else
    echo "envrc: play_launch not on PATH — run 'just setup'"
fi

# ── nano-ros (nros CLI, SDK paths) ──────────────────────────────────────────
#
# Scrub a FOREIGN activation before layering ours on top. `activate.sh` is not
# idempotent across roots: sourcing the sibling's copy exports NROS_REPO_DIR,
# nano_ros_ROOT and three RTOS config dirs, and PREPENDS that root's
# `scripts/bin`, `third-party/ninja` and `third-party/make` to PATH. Re-sourcing
# ours re-exports the variables but cannot un-prepend the paths, so a stale
# `nros` binary keeps winning `command -v` while every variable says otherwise.
# That is the 2026-08-26 failure: NANO_ROS_ROOT alone was never the problem.
#
# So: drop PATH entries under ANY nano-ros root that is not the chosen one, and
# unset what activate.sh derives so it re-derives against the right root.
if [ -f "$NANO_ROS_ROOT/activate.sh" ]; then
    PATH="$(
        printf '%s' "$PATH" | tr ':' '\n' | awk -v keep="$NANO_ROS_ROOT" '
            index($0, "/nano-ros/") == 0 { print; next }   # unrelated entry
            index($0, keep "/") == 1     { print }         # ours, keep it
        ' | paste -sd:
    )"
    export PATH
    unset NROS_REPO_DIR nano_ros_ROOT FREERTOS_CONFIG_DIR NETX_CONFIG_DIR \
          THREADX_CONFIG_DIR NROS_ESP_IDF_ENV_SHIM NROS_ESP_IDF_WORKSPACE
    source "$NANO_ROS_ROOT/activate.sh" >/dev/null 2>&1
    export nano_ros_ROOT="$NANO_ROS_ROOT"
else
    echo "envrc: MISSING nano-ros checkout at $NANO_ROS_ROOT (set NANO_ROS_ROOT)"
fi

# The island links the nano-ros SDK CycloneDDS, never the ROS one (a sourced
# ROS env otherwise shadows the SDK lib at runtime — porting-notes env entry).
export NROS_CYCLONEDDS_HOME="${NROS_CYCLONEDDS_HOME:-$HOME/.nros/sdk/cyclonedds/0.10.5-nros1}"

# ── Demo graph env (single domain, shared cyclone config) ───────────────────
# Direct-connection structure: Autoware, the island, and every CLI tool talk
# on domain 10 — no domain bridges. The shared config gives every host
# participant a predictable participant index (auto, range 120) so the
# multicast-less native_sim island's unicast 127.0.0.1 peer scan can
# discover it (rationale in demo/cyclonedds.xml). The island itself runs
# its own multicast-off profile (ISLAND_URI in the justfile), not this one.
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export ROS_DOMAIN_ID=10
export CYCLONEDDS_URI="file://$PWD/demo/cyclonedds.xml"
