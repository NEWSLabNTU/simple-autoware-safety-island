<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoware_mrm_emergency_stop_operator</name>
  <version>0.48.0</version>
  <description>The MRM emergency stop operator package (nano-ros port of the Autoware 1.5.0 node)</description>
  <maintainer email="jerry73204@gmail.com">Hsiang-Jui Lin</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- nano-ros port: dep set trimmed to what the node actually uses.
       Dropped vs upstream: autoware_utils (update_param helper — param
       callback not ported), rclcpp/rclcpp_components (nano-ros provides the
       node surface), autoware_adapi_v1_msgs / std_msgs / std_srvs (unused by
       this node's sources). -->
  <depend>autoware_control_msgs</depend>
  <depend>tier4_system_msgs</depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
