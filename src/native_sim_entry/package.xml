<?xml version="1.0"?>
<package format="3">
  <name>native_sim_entry</name>
  <version>0.1.0</version>
  <description>Entry pkg -- the Zephyr native_sim island the demo runs (Cyclone DDS).</description>
  <maintainer email="jerry73204@gmail.com">Hsiang-Jui Lin</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>safety_island_bringup</exec_depend>
  <export>
    <build_type>cmake</build_type>
    <!-- The deployment (board, rmw, domain) is [image.native_sim] in
         src/safety_island_bringup/system.toml, which names this package as
         its entry: nano-ros keeps system.toml only in a bringup package
         (RFC-0121 D2). -->
  </export>
</package>
