<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoware_planning_msgs</name>
  <version>1.11.0</version>
  <description>Vendored subset of autoware_planning_msgs: RouteState (Autoware 1.5.0) and Trajectory/TrajectoryPoint (Autoware 2.0.0, 1.13.0; identical in 1.5.0) for the L4 island.</description>
  <maintainer email="jerry73204@gmail.com">Hsiang-Jui Lin</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>

  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
