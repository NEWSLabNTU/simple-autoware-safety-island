<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>island_restamp</name>
  <version>0.1.0</version>
  <description>phase9-W9: the island's hazard-lights command republished with the host's stamp at receipt, so vehicle_cmd_gate compares it on one clock (the board stamps from boot; Autoware runs on the wall clock or on /clock).</description>
  <maintainer email="d10922013@csie.ntu.edu.tw">aeon</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>autoware_vehicle_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rosgraph_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
