<?xml version="1.0" encoding="UTF-8" ?>
<!-- Bridge/Autoware cyclone config (pattern from the ASI fork's demo/).
     Domain 1 = Autoware: cyclone DEFAULT interface + multicast. The 1.5.0
     install does NOT set CYCLONEDDS_URI, so the sim sits on the default
     interface — a lo-pinned participant is DEAF to it on hosts where lo
     lacks the MULTICAST flag (cyclone: "selected interface lo is not
     multicast-capable: disabling multicast").
     Domain 2 = the island, pinned to loopback with UNICAST peer discovery:
     the 127.0.0.1 peer scan reaches both the NATIVE island and the ZEPHYR
     island (native_sim bakes multicast-off unicast discovery —
     porting-notes 19); lo multicast is never relied on. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="1">
    <General>
      <AllowMulticast>spdp</AllowMulticast>
    </General>
  </Domain>
  <Domain id="2">
    <General>
      <AllowMulticast>spdp</AllowMulticast>
      <Interfaces>
        <NetworkInterface name="lo" priority="default" multicast="true"/>
      </Interfaces>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>30</MaxAutoParticipantIndex>
      <Peers><Peer Address="127.0.0.1"/></Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
