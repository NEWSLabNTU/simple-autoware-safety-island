<?xml version="1.0" encoding="UTF-8" ?>
<!-- Shared domain-1 cyclone config for EVERY host-side participant (the sim
     tree, the scenario driver, ros2 CLI via `just topics`).

     The island (Zephyr native_sim) runs multicast-OFF unicast-peer
     discovery (NSOS breaks cyclone's multicast waitset — nano-ros phase
     180): it finds host participants by pinging the SPDP unicast ports for
     participant indices 0..MaxAutoParticipantIndex at 127.0.0.1. That only
     works if every host participant HAS a predictable index — cyclone's
     default MaxAutoParticipantIndex (9) overflows on Autoware's ~40
     processes and overflowed participants fall back to a RANDOM port,
     invisible to the island forever. Hence: auto index, range 120, on
     every d1 process. Multicast stays on host-side (host<->host discovery
     keeps working the stock way).

     Do NOT raise this to "match" the island's own range: with <Peers> set,
     cyclone expands each peer into ONE SPDP LOCATOR PER INDEX
     (add_addresses_to_addrset_1 loops to MaxAutoParticipantIndex), so this
     number multiplies discovery state on every one of the ~100+ host
     participants. The island scanning a wider range than hosts occupy is the
     intended asymmetry, not a mismatch to fix: the island finds hosts by
     scanning, and hosts learn the island from the SPDP it unicasts to them, so
     they never need to scan up to its index. -->
<!-- Everything is PINNED TO LOOPBACK: the island's NSOS sockets are
     lo-bound, so it can only reach participants that advertise 127.0.0.1
     locators — a participant on the default (eth) interface receives the
     island's SPDP but never gets its SEDP/data back. The unicast Peers
     scan keeps host<->host discovery alive even where lo lacks the
     MULTICAST flag (cyclone then disables multicast on lo); with
     `ip link set lo multicast on`, spdp multicast works as a bonus. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" priority="default" multicast="default"/>
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers><Peer Address="127.0.0.1"/></Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
