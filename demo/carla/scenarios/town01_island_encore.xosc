<?xml version="1.0"?>
<!-- The encore (HPC loss) of the CARLA island demo
     (docs/design/carla-island-demo.md, section 2.1; unit C4). The same road,
     start and route as town01_island_odd.xosc (see its header for the
     geometry and the speed), with no ODD declared: the act is not an ODD
     exit, and run-board.sh starts no odd_monitor for it.

     The trigger is the scenario's: when the ego reaches x 285 (30 m after
     the start, at cruise by then), a CustomCommandAction whose type SSv2
     does not know is fork-exec'd (openscenario_interpreter ForkExecCommand,
     which waitpid()s, so the command returns at once):
     `$(env SAI_ACT_TRIGGER true) hpc-loss`. run-board.sh (sim carla) sets
     SAI_ACT_TRIGGER to demo/carla/act_trigger.py and the run's socket; the
     act daemon (tools/eval/scenario.py) receives `hpc-loss` and SIGSTOPs
     the availability gate, the encore's mechanism. Without the variable the
     action runs `true hpc-loss`, a no-op, and the scenario still runs.

     Success 60 s (simulation) after the ego was below 0.1 m/s having moved
     5 m, as in town01_island_odd.xosc (StandStillCondition never fires for
     the CARLA ego; the 60 s keep the world running past the act's readout,
     since the scenario's end pauses the world and the island then raises an
     HPC loss that belongs to no act). -->
<OpenSCENARIO>
	<FileHeader author="simple-autoware-safety-island" date="2026-10-14T00:00:00+00:00" description="Town01: the HPC is lost at a place on the straight; the island stops the ego" revMajor="1" revMinor="2" />
	<ParameterDeclarations />
	<CatalogLocations />
	<RoadNetwork>
		<LogicFile filepath="$(env CARLA_MAPS)/Town01" />
	</RoadNetwork>
	<Entities>
		<ScenarioObject name="ego">
			<Vehicle name="vehicle.tesla.model3" vehicleCategory="car">
				<BoundingBox>
					<Center x="1.5" y="0.0" z="0.9" />
					<Dimensions width="2.1" height="1.8" length="4.5" />
				</BoundingBox>
				<Performance maxSpeed="7.0" maxAcceleration="15.0" maxDeceleration="15.0" />
				<Axles>
					<FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="3.1" positionZ="0.3" />
					<RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3" />
				</Axles>
				<Properties />
			</Vehicle>
			<ObjectController>
				<Controller name="Autoware">
					<Properties>
						<!-- SSv2 sends the controller's maxSpeed, not Performance
						     maxSpeed, to Autoware as its velocity limit
						     (simulator_core.hpp applyAssignControllerAction ->
						     /api/autoware/set/velocity_limit); without it the limit
						     sent is DBL_MAX (unit C4). -->
						<Property name="maxSpeed" value="7.0" />
						<Property name="maxJerk" value="1.5" />
						<Property name="minJerk" value="-1.5" />
					</Properties>
				</Controller>
			</ObjectController>
		</ScenarioObject>
	</Entities>
	<Storyboard>
		<Init>
			<Actions>
				<Private entityRef="ego">
					<PrivateAction>
						<TeleportAction>
							<Position>
								<WorldPosition x="315.0" y="-130.3" z="0.3" h="3.14159" p="0" r="0" />
							</Position>
						</TeleportAction>
					</PrivateAction>
					<PrivateAction>
						<RoutingAction>
							<AcquirePositionAction>
								<Position>
									<WorldPosition x="120.0" y="-129.8" z="0.0" h="3.14159" p="0" r="0" />
								</Position>
							</AcquirePositionAction>
						</RoutingAction>
					</PrivateAction>
				</Private>
			</Actions>
		</Init>
		<Story name="island_encore">
			<Act name="encore_act">
				<ManeuverGroup maximumExecutionCount="1" name="ego_maneuvers">
					<Actors selectTriggeringEntities="false">
						<EntityRef entityRef="ego" />
					</Actors>
					<Maneuver name="fault">
						<Event name="hpc_loss" priority="parallel">
							<Action name="hpc_loss_trigger">
								<UserDefinedAction>
									<CustomCommandAction type="$(env SAI_ACT_TRIGGER true) hpc-loss" />
								</UserDefinedAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="at_the_place" delay="0" conditionEdge="none">
										<ByEntityCondition>
											<TriggeringEntities triggeringEntitiesRule="any">
												<EntityRef entityRef="ego" />
											</TriggeringEntities>
											<EntityCondition>
												<ReachPositionCondition tolerance="3.0">
													<Position>
														<WorldPosition x="285.0" y="-130.3" z="0.0" h="0" p="0" r="0" />
													</Position>
												</ReachPositionCondition>
											</EntityCondition>
										</ByEntityCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
					</Maneuver>
					<Maneuver name="end_conditions">
						<!-- The island's stop. Success 60 s
						     (simulation) after an instant at which the ego was below
						     0.1 m/s having moved 5 m from its start; conditions in one
						     group are ANDed and each `delay` reads its condition 60 s
						     back, so both describe the same instant. Not
						     StandStillCondition: SSv2 counts standstill only at a speed
						     of exactly 0; the stopped CARLA ego never met it (run c3-b1). The
						     60 s keep the world running past the act and its readout
						     (at 20 s the scenario ended before a slow readout, run
						     c3-b3):
						     the scenario's end pauses the world, the availability goes
						     silent and the island raises an HPC loss, which belongs to
						     no act. Act a is town01_island_takeover.xosc. -->
						<Event name="success" priority="parallel">
							<Action name="exit_success">
								<UserDefinedAction>
									<CustomCommandAction type="exitSuccess" />
								</UserDefinedAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="moved" delay="60" conditionEdge="none">
										<ByEntityCondition>
											<TriggeringEntities triggeringEntitiesRule="any">
												<EntityRef entityRef="ego" />
											</TriggeringEntities>
											<EntityCondition>
												<DistanceCondition freespace="false" rule="greaterThan" value="5.0" relativeDistanceType="euclidianDistance" coordinateSystem="entity" routingAlgorithm="undefined">
													<Position>
														<WorldPosition x="315.0" y="-130.3" z="0.0" h="0" p="0" r="0" />
													</Position>
												</DistanceCondition>
											</EntityCondition>
										</ByEntityCondition>
									</Condition>
									<Condition name="stopped" delay="60" conditionEdge="none">
										<ByEntityCondition>
											<TriggeringEntities triggeringEntitiesRule="any">
												<EntityRef entityRef="ego" />
											</TriggeringEntities>
											<EntityCondition>
												<SpeedCondition value="0.1" rule="lessThan" />
											</EntityCondition>
										</ByEntityCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
						<Event name="timeout" priority="parallel">
							<Action name="exit_failure">
								<UserDefinedAction>
									<CustomCommandAction type="exitFailure" />
								</UserDefinedAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="timeout_condition" delay="0" conditionEdge="none">
										<ByValueCondition>
											<SimulationTimeCondition value="240" rule="greaterThan" />
										</ByValueCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
					</Maneuver>
				</ManeuverGroup>
				<StartTrigger>
					<ConditionGroup>
						<Condition name="start" delay="0" conditionEdge="none">
							<ByValueCondition>
								<SimulationTimeCondition value="0" rule="greaterThan" />
							</ByValueCondition>
						</Condition>
					</ConditionGroup>
				</StartTrigger>
			</Act>
		</Story>
		<StopTrigger />
	</Storyboard>
</OpenSCENARIO>
