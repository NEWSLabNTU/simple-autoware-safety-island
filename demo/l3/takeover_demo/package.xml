<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>takeover_demo</name>
  <version>0.1.0</version>
  <description>
    Host side of the phase-8 L3 takeover demo: ODD monitor, takeover HMI,
    availability gate, driver button, hazard relay, graph watcher and the
    scenario driver. Runs on rmw_zenoh_cpp in domain 10 beside Autoware 1.5.0.
  </description>
  <maintainer email="d10922013@csie.ntu.edu.tw">aeon</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>autoware_adapi_v1_msgs</exec_depend>
  <exec_depend>autoware_planning_msgs</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>
  <exec_depend>tier4_system_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
