 using namespace std::chrono_literals;
 
 using rclcpp::exceptions::throw_from_rcl_error;
+
+namespace
+{
+// sai phase8-W11: the executor keeps each callback group's notify guard
+// condition in its wait set through a RAW pointer
+// (weak_groups_to_guard_conditions_, memory_strategy_->guard_conditions_).
+// A callback group destroyed while another thread of a MultiThreadedExecutor
+// is inside rcl_wait() frees that guard condition under the waiter (its
+// destructor even triggers it first, so the waiter wakes right into the
+// freed object): ros2/rclcpp#2445, open on Humble. On rmw_zenoh_cpp the
+// guard condition is a heap object with a mutex, so the waiter writes into
+// freed memory (heap corruption, a later abort in malloc) or blocks on a
+// stale mutex. Here the executor holds a strong reference to every guard
+// condition it put in the wait set until it takes it out again, on the
+// thread that owns the wait set. Kept outside the class so the ABI of
+// librclcpp.so is unchanged.
+std::mutex g_gc_keepalive_mutex;
+std::unordered_map<
+  const rclcpp::Executor *,
+  std::unordered_map<const rclcpp::GuardCondition *, rclcpp::GuardCondition::SharedPtr>>
+g_gc_keepalive;
+
+void keep_guard_condition(const rclcpp::Executor * e, rclcpp::GuardCondition::SharedPtr gc)
+{
+  std::lock_guard<std::mutex> lock(g_gc_keepalive_mutex);
+  g_gc_keepalive[e][gc.get()] = std::move(gc);
+}
+
+void release_guard_condition(const rclcpp::Executor * e, const rclcpp::GuardCondition * gc)
+{
+  rclcpp::GuardCondition::SharedPtr last;  // destroyed after the lock is dropped
+  std::lock_guard<std::mutex> lock(g_gc_keepalive_mutex);
+  auto it = g_gc_keepalive.find(e);
+  if (it == g_gc_keepalive.end()) {
+    return;
+  }
+  auto jt = it->second.find(gc);
+  if (jt != it->second.end()) {
+    last = std::move(jt->second);
+    it->second.erase(jt);
+  }
+}
+
+void release_all_guard_conditions(const rclcpp::Executor * e)
+{
+  std::unordered_map<const rclcpp::GuardCondition *, rclcpp::GuardCondition::SharedPtr> last;
+  std::lock_guard<std::mutex> lock(g_gc_keepalive_mutex);
+  auto it = g_gc_keepalive.find(e);
+  if (it != g_gc_keepalive.end()) {
+    last.swap(it->second);
+    g_gc_keepalive.erase(it);
+  }
+}
+}  // namespace
 using rclcpp::AnyExecutable;
 using rclcpp::Executor;
 using rclcpp::ExecutorOptions;
