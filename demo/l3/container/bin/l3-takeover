#!/usr/bin/env bash
# The takeover_demo nodes (ODD monitor, gate, HMI, hazard relay, button,
# graph watcher). Blocks. Args go to the launch file, e.g.
#   l3-takeover driver_button:=false     (run `l3-button` in its own terminal)
source "$(dirname "$(readlink -f "$0")")/l3-env"
exec ros2 launch takeover_demo takeover.launch.xml "$@"
