#!/usr/bin/env bash
# Autoware 1.5.0 planning simulator on rmw_zenoh_cpp, domain 10, stock MRM
# off, for the L3 demo. Blocks; Ctrl-C stops the tree.
#
#   l3-autoware                  the converter publishes .../availability_raw;
#                                the island reads takeover_demo's gate
#   L3_GATE=0 l3-autoware        stock wiring (converter -> .../availability),
#                                no gate needed
#   L3_RVIZ=true l3-autoware     RViz inside (needs DISPLAY and the X socket)
#   L3_CONTAINER_MODE=observable  play_launch's container mode (default: stock)
#   extra args go to play_launch
#
# Why `stock` (measured 2026-09-28, host, rmw_zenoh_cpp 0.1.9, play_launch
# 0.12.0): with `observable` every input of behavior_path_planner flows and
# it passes its own isDataReady, yet it never publishes a path, so the whole
# planning chain reads 0 Hz and engage is refused ("The target mode is not
# available"); logging_diag_graph also dies at start. With `isolated` (117
# processes, 7.3 GiB RSS) the mission planner never set the route in the one
# run tried. With `stock` the chain runs at 10 Hz and the drive engages.
#
# perception/enable_detection_failure:=false selects the dummy perception
# publisher WITHOUT autoware_shape_estimation. That node links libcudart.so.12
# and TensorRT (libnvinfer/_plugin/nvonnxparser .so.10); the image stubs the
# TensorRT PACKAGES (planning simulator only, no CUDA), so it dies at load
# with "libcudart.so.12: cannot open shared object file". The detection-
# failure emulation it serves is not part of this demo.
#
# Needs a zenoh router the session can reach: rmw_zenoh_cpp dials
# tcp/localhost:7447 by default (the host's stock rmw_zenohd; the container
# runs on the host network). Nothing here starts one. Another port:
# L3_ROUTER_PORT=<p> plus ZENOH_CONFIG_OVERRIDE='connect/endpoints=["tcp/localhost:<p>"]'
# (run.sh passes both through).
source "$(dirname "$(readlink -f "$0")")/l3-env"
set -e
topic=/system/operation_mode/availability
[ "${L3_GATE:-1}" = "1" ] && topic=/system/operation_mode/availability_raw
log_dir="${L3_LOG_DIR:-$HOME/l3-play_log}"
mkdir -p "$log_dir"
port="${L3_ROUTER_PORT:-7447}"
if ! (exec 3<>/dev/tcp/127.0.0.1/"$port") 2>/dev/null; then
    echo "l3-autoware: nothing listens on 127.0.0.1:$port -- start the router first (just l3-router $port)" >&2
    exit 1
fi
echo "l3-autoware: $(command -v play_launch) ($(play_launch --version 2>/dev/null)), RMW $RMW_IMPLEMENTATION, domain $ROS_DOMAIN_ID"
echo "l3-autoware: tier4_system_launch from $(ros2 pkg prefix tier4_system_launch), availability converter -> $topic"
web=(--disable-web-ui)
[ "${L3_WEB:-0}" = "1" ] && web=()
exec play_launch launch autoware_launch planning_simulator.launch.xml \
    map_path:="$L3_MAP" vehicle_model:=sample_vehicle sensor_model:=sample_sensor_kit \
    rviz:="${L3_RVIZ:-false}" operation_mode_availability_topic:="$topic" \
    perception/enable_detection_failure:=false \
    --container-mode "${L3_CONTAINER_MODE:-stock}" --log-dir "$log_dir" "${web[@]}" "$@"
